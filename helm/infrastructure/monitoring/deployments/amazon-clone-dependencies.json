{
  "title": "Amazon Clone - Dependencies",
  "uid": "amazon-clone-dependencies",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["amazon-clone", "dependencies"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "MongoDB CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"amazon-clone\",pod=~\"mongo-.*\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "MongoDB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MongoDB Memory",
