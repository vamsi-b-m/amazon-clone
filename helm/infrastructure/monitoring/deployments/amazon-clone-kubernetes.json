{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running Pods",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"amazon-clone\",phase=\"Running\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ready Pods",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"amazon-clone\",condition=\"true\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pod Restarts - 1h",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"amazon-clone\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unavailable Replicas",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=\"amazon-clone\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU Usage by Pod",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"amazon-clone\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory Usage by Pod",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"amazon-clone\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU Requests vs Usage",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_resource_requests{namespace=\"amazon-clone\",resource=\"cpu\"})",
          "legendFormat": "{{pod}} request",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"amazon-clone\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}} usage",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory Requests vs Usage",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_resource_requests{namespace=\"amazon-clone\",resource=\"memory\"})",
          "legendFormat": "{{pod}} request",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"amazon-clone\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}} usage",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Deployment Status",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"amazon-clone\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"amazon-clone\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "deployment",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container Restarts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"amazon-clone\"}[1h]))",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Pod Problems",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "expr": "kube_pod_status_phase{namespace=\"amazon-clone\",phase!=\"Running\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "amazon-clone",
    "kubernetes",
    "platform",
    "sre"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Amazon Clone - Kubernetes",
  "uid": "amazon-clone-kubernetes",
  "version": 2
}
