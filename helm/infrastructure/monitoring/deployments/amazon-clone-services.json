      "targets": [
        {
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=\"amazon-clone\",container=~\"$service\"}[5m])) by (container) / clamp_min(sum(kube_pod_container_resource_requests{namespace=\"amazon-clone\",container=~\"$service\",resource=\"cpu\"}) by (container), 0.001)",
          "legendFormat": "{{container}}",
          "refId": "A"
